# Copy to .env for local use. Never commit the real .env.
ADMIN_TOKEN=change-me-to-a-long-random-string-32+
DATABASE_PATH=data/lama.sqlite3
TZ_OFFSET_MINUTES=345
# Optional Free Fire name lookup
PLAYER_LOOKUP_URL=
PLAYER_LOOKUP_REGION=BD
PLAYER_LOOKUP_API_KEY=
# Owner alerts (use one or both). See README "Order alerts".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_URL=
NOTIFY_UNPAID=false
# Storage. On Render keep DATABASE_PATH on the disk, e.g. /var/data/lama.sqlite3
PERSISTENT_STORAGE=auto
# Telegram DB backups (on by default when Telegram is configured), at most once per interval
BACKUP_TELEGRAM=true
BACKUP_INTERVAL_MIN=60
